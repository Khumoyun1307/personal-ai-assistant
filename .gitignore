# Secrets and local environment
.env
.env.*
!.env.example

# Runtime data: probe dumps, backups, logs. Never committed (AGENTS §9).
var/

# Content-free server release records and locks (never deploy configuration).
/deploy/release-state
/deploy/release-in-progress
/deploy/pre-deploy-backup
/deploy/.release-lock
/deploy/.release-state.*

