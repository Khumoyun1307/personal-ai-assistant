{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "P2 Antony QA worker result",
  "type": "object",
  "additionalProperties": false,
  "required": ["check_id", "status", "reviewed_heads", "posted_urls", "summary"],
  "properties": {
    "check_id": {"type": "string", "pattern": "^[a-f0-9]{32}$"},
    "status": {
      "type": "string",
      "enum": ["idle", "completed", "blocked", "failed"]
    },
    "reviewed_heads": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["pr", "sha"],
        "properties": {
          "pr": {"type": "integer", "minimum": 1},
          "sha": {"type": "string", "pattern": "^[a-f0-9]{40}$"}
        }
      }
    },
    "posted_urls": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^https://github\\.com/Khumoyun1307/personal-ai-assistant/(pull|issues)/[1-9][0-9]*(#[A-Za-z0-9_-]+)?$"
      }
    },
    "summary": {"type": "string"}
  }
}
