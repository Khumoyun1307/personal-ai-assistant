{
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/*.env)",
      "Read(./var/**)",
      "Edit(**/.env)",
      "Edit(**/.env.local)",
      "Edit(**/*.env)",
      "Edit(./var/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-secrets.ps1\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
