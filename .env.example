# Example configuration. Copy to .env and fill in real values.
# .env is git-ignored and never displayed or pasted into chat (AGENTS §9).
# Every setting the application reads is listed here with a placeholder.

# --- Application -------------------------------------------------------------
# dev | prod. prod enables stricter checks (see config.py).
APP_ENV=dev
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# json | console. prod must use json.
LOG_FORMAT=console

# --- Database ----------------------------------------------------------------
# SQLAlchemy URL; the driver must be psycopg (ARCHITECTURE §3).
# Inside the dev container the host is the Compose service name `db`.
DATABASE_URL=postgresql+psycopg://assistant:CHANGE_ME@db:5432/assistant
# Separate database used by integration tests; created by deploy/db-init/.
TEST_DATABASE_URL=postgresql+psycopg://assistant:CHANGE_ME@db:5432/assistant_test

# --- Telegram ----------------------------------------------------------------
# From @BotFather. Never paste a real token into chat, issues or docs.
BOT_TOKEN=123456789:AA-REPLACE-WITH-REAL-TOKEN
# Comma-separated Telegram user ids allowed to use the control chat (AGENTS §6.12).
OWNER_TELEGRAM_IDS=

# M00 probe only: chats whose full payload may be written to var/probe/.
# Anything not listed is recorded as update type + update_id + a hash of
# chat.id. Leaving this empty withholds every payload (fail closed).
PROBE_ALLOWED_CHAT_IDS=

# --- LLM provider (OpenAI) ---------------------------------------------------
OPENAI_API_KEY=sk-proj-REPLACE-WITH-REAL-KEY
LLM_DEFAULT_MODEL=gpt-6-luna
# Monthly spend target in USD; drives alerts. Empty disables the check.
LLM_MONTHLY_BUDGET_USD=
# Reasoning effort for owner requests: none|minimal|low|medium|high|xhigh|max.
# Empty sends no effort parameter (for a model that rejects it).
LLM_OWNER_REQUEST_EFFORT=medium

# --- Feature flags -----------------------------------------------------------
# Comma-separated release flags that are ON. Everything defaults off (AGENTS §8).
# Known flags: tool.get_status
FEATURE_FLAGS=

# --- Operations --------------------------------------------------------------
# Dead-man's-switch ping URL (ARCHITECTURE §17). Empty disables heartbeats.
HEARTBEAT_URL=

# --- Postgres (dev stack only; must match DATABASE_URL above) ----------------
POSTGRES_USER=assistant
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=assistant
